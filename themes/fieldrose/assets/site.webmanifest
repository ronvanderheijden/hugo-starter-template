{
    "name": {{ site.Title | jsonify }},
    "short_name": {{ site.Title | jsonify }},
    "start_url": {{ site.Home.RelPermalink | jsonify }},
    "icons": [
        { "src": {{ "icon-192.png" | relURL | jsonify }}, "sizes": "192x192", "type": "image/png" },
        { "src": {{ "icon-512.png" | relURL | jsonify }}, "sizes": "512x512", "type": "image/png" }
    ],
    "theme_color": "#2563eb",
    "background_color": "#ffffff",
    "display": "minimal-ui"
}
